include_guard(GLOBAL)
get_filename_component(LITTLECHAT_REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(LITTLECHAT_DEPENDENCY_ROOT "${LITTLECHAT_REPO_ROOT}/build/_deps" CACHE PATH "Local pinned dependency sources")
option(LITTLECHAT_ENABLE_SANITIZERS "Enable AddressSanitizer and UndefinedBehaviorSanitizer" OFF)

if(NOT TARGET littlechat_build_options)
    add_library(littlechat_build_options INTERFACE)
    target_compile_features(littlechat_build_options INTERFACE cxx_std_17)
    if(LITTLECHAT_ENABLE_SANITIZERS)
        if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
            message(FATAL_ERROR "Sanitizers require GCC or Clang")
        endif()
        target_compile_options(littlechat_build_options INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(littlechat_build_options INTERFACE -fsanitize=address,undefined)
    endif()
endif()

function(littlechat_verify_checkout directory expected_commit)
    find_package(Git REQUIRED)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" rev-parse HEAD
        RESULT_VARIABLE result OUTPUT_VARIABLE actual_commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT result EQUAL 0 OR NOT actual_commit STREQUAL expected_commit)
        message(FATAL_ERROR "Pinned dependency mismatch at ${directory}; run scripts/fetch-linux-deps.sh without overwriting existing sources")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" diff --binary HEAD
        RESULT_VARIABLE diff_result OUTPUT_VARIABLE actual_diff)
    set(expected_diff "")
    if(ARGC GREATER 2)
        file(READ "${ARGV2}" expected_diff)
    endif()
    if(NOT diff_result EQUAL 0 OR NOT "${actual_diff}" STREQUAL "${expected_diff}")
        message(FATAL_ERROR "Unexpected dependency modifications at ${directory}; only the tracked patch is permitted")
    endif()
endfunction()

function(littlechat_add_googletest)
    if(TARGET GTest::gtest_main)
        return()
    endif()
    set(source "${LITTLECHAT_DEPENDENCY_ROOT}/googletest-src")
    littlechat_verify_checkout("${source}" b514bdc898e2951020cbdca1304b75f5950d1f59)
    set(INSTALL_GTEST OFF CACHE BOOL "" FORCE)
    set(BUILD_GMOCK OFF CACHE BOOL "" FORCE)
    add_subdirectory("${source}" "${CMAKE_BINARY_DIR}/_deps/googletest-build" EXCLUDE_FROM_ALL)
endfunction()
